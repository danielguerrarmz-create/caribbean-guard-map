# Cloudflare Pages reads this file from the root of the deployed folder.
#
# THE PRIMARY TARGET IS VERCEL (Daniel's call, 2026-09-14) and Vercel ignores
# this file entirely: its rules live in web/vercel.json. This is kept so that
# Cloudflare Pages remains a one-drag fallback, and the two MUST be changed
# together. A caching rule that exists on one host and not the other is a bug
# that only appears after a migration, which is the worst time to find it.

# ---------------------------------------------------------------------------
# The document carries the safety verdicts, so it is never cached.
# The service worker already serves it network-first with a cached fallback; this
# makes the browser's own cache agree with that rather than fight it.
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/source-map.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The worker itself. `no-cache` means revalidate every time, which is what makes
# the update banner able to notice a new build at all.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

# ---------------------------------------------------------------------------
# Imagery and Leaflet: a year, immutable.
#
# READ THIS BEFORE REBUILDING THE TILES. `immutable` is only safe on files whose
# NAME changes when their contents change, and a tile's name is its coordinate:
# tiles/15/8850/15500.jpg keeps that name forever, whatever imagery is inside it.
# A browser that has cached one will not ask again for a year.
#
# So rebuilding web/tiles/ over the same coordinates is invisible to a returning
# visitor. If the imagery is ever re-fetched from a different source or a
# different date, serve it from a new prefix (tiles2/) and change the URL
# template in index.html plus the generated lists in sw.js. Deploying alone is
# not enough.
#
# The service worker re-fetches with `cache: "reload"`, which bypasses this, so
# the exposure is a returning visitor whose worker has been evicted. Visual
# staleness only: no safety verdict lives in a tile.
/tiles/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Leaflet is version pinned at 1.9.4 and genuinely never changes under this path.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# The hazard annotations are the one file a guard's edit could reach without a
# code change, so it revalidates quickly and serves the old copy meanwhile.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
